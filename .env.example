APP_NAME=Skoolyst Module
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/skoolyst-module/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skoolyst_module
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=skoolyst_eCommerce_store
SESSION_SECURE=false
SESSION_HTTP_ONLY=true

UPLOAD_MAX_SIZE=10485760

SKOOLYST_MAIL_API_URL=https://ads.skoolyst.com/api/v1
SKOOLYST_MAIL_API_KEY=
SKOOLYST_MAIL_SOURCE_APP=skoolyst-store

# "Login with Skoolyst" SSO — get client_id/secret from skoolyst.com
# Dashboard -> Connected Apps. redirect_uri must be registered there exactly.
SKOOLYST_AUTH_BASE=https://skoolyst.com
SKOOLYST_AUTH_CLIENT_ID=
SKOOLYST_AUTH_CLIENT_SECRET=
SKOOLYST_AUTH_REDIRECT_URI=http://localhost/Projects/Skoolyst-shop-system/skoolyst-module-blueprint/public/auth/skoolyst/callback
